(version 1)
(rule "Prototype minimum clearance" (constraint clearance (min 0.20mm)))
(rule "Prototype minimum trace" (constraint track_width (min 0.20mm)))
(rule "Prototype via diameter" (constraint via_diameter (min 0.60mm)))
(rule "Prototype drilled hole" (constraint hole_size (min 0.30mm)))
(rule "Board edge clearance" (constraint edge_clearance (min 0.50mm)))
(rule "Power trace planning" (condition "A.NetClass == 'POWER'") (constraint track_width (min 0.50mm)))
(rule "CAN trace planning" (condition "A.NetClass == 'CAN'") (constraint track_width (min 0.25mm)))
(rule "LSM6DSL internal pad clearance" (condition "A.Reference == 'U4' && B.Reference == 'U4'") (constraint clearance (min 0.15mm)))
